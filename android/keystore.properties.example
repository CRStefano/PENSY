# To sign release builds on your own computer, copy this file to
# android/keystore.properties and fill it in. keystore.properties is in
# .gitignore: it never goes to GitHub, and neither does the .keystore file.
#
# storeFile is relative to the android/ folder (or an absolute path).
storeFile=../tools/pensy-test.keystore
storePassword=CHANGE_ME
keyAlias=pensy
keyPassword=CHANGE_ME
