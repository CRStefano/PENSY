# Cross-compiling for Android with a plain clang and the NDK sysroot.
# Set NDK_SYSROOT, NDK_RESOURCE_DIR and ANDROID_TRIPLE (e.g. aarch64-linux-android26).
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR $ENV{ANDROID_CPU})
set(CMAKE_SYSROOT $ENV{NDK_SYSROOT})
set(CMAKE_C_COMPILER clang)
set(CMAKE_CXX_COMPILER clang++)
set(CMAKE_C_COMPILER_TARGET $ENV{ANDROID_TRIPLE})
set(CMAKE_CXX_COMPILER_TARGET $ENV{ANDROID_TRIPLE})
set(_common "-resource-dir=$ENV{NDK_RESOURCE_DIR} -fPIC -ffunction-sections -fdata-sections -fvisibility=hidden")
set(CMAKE_C_FLAGS_INIT "${_common}")
set(CMAKE_CXX_FLAGS_INIT "${_common} -fvisibility-inlines-hidden")
set(_link "-fuse-ld=lld -rtlib=compiler-rt -unwindlib=libunwind -L$ENV{NDK_STUBS}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_link}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_link}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
